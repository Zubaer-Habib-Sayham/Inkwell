<main>
<%- include("partials/header", { title: "Home" }) %>

<section class="hero">
  <p class="eyebrow">PERSONAL PUBLISHING</p>

  <h1>Write.<br>Think.<br>Publish.</h1>

  <p class="hero-text">
    A small corner of the internet for ideas, experiments and things worth sharing.
  </p>

  <a href="/compose" class="button">Write an article</a>
</section>

<div class="section-heading">

  <div>
    <p class="eyebrow">LATEST</p>
    <h2>Recent articles</h2>
  </div>

  <form action="/" method="GET" class="search-form">

    <input
      type="search"
      name="search"
      placeholder="Search articles..."
      value="<%= search %>"
    >

    <button type="submit">Search</button>

  </form>

</div>

  <% if (posts.length === 0) { %>

    <div class="empty-state">

        <h3>No articles found.</h3>

        <p>
        Try searching for something else.
        </p>

    </div>

    <% } else { %>

    <div class="article-grid">

        <% posts.forEach(post => { %>

        <a href="/post/<%= post.id %>" class="article-link">

            <article class="article-card">

            <p class="article-category">
                <%= post.category %>
            </p>

            <h3>
                <%= post.title %>
            </h3>

            <p class="article-excerpt">
                <%= post.excerpt %>
            </p>

            <div class="article-meta">
                <span><%= post.date %></span>
                <span><%= post.readTime %> min read</span>
            </div>

            </article>

        </a>

        <% }) %>

    </div>

  <% } %>

    </div>

</section>

<%- include("partials/footer") %>